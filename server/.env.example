# ==============================================================================
# ALKHIDMAT FOUNDATION LAHORE - BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Core Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Notification Dispatcher Configuration (Option 1: Database-Free)
# Modes: console (logs to terminal) | smtp | resend
DISPATCH_MODE=console

# Department Notification Email Recipients
NOTIFICATION_EMAIL_CONTACT=info@alkhidmat.com.pk
NOTIFICATION_EMAIL_VOLUNTEER=volunteer@alkhidmat.com.pk
NOTIFICATION_EMAIL_COLLECTION=collections@alkhidmat.com.pk
NOTIFICATION_EMAIL_HR=hr@alkhidmat.com.pk

# SMTP Settings (Required only when DISPATCH_MODE=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Resend API Key (Required only when DISPATCH_MODE=resend)
RESEND_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional Database URL (Only if transitioning to a dedicated DB in the future)
# DATABASE_URL=postgresql://user:password@localhost:5432/alkhidmat_lahore?schema=public
