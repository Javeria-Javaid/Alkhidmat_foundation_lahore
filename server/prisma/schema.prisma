// ==============================================================================
// ALKHIDMAT FOUNDATION LAHORE - PRISMA SCHEMA (PHASE 1: FOUNDATION)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  CONTENT_EDITOR
  HR
  VOLUNTEER_MANAGER
  FINANCE
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum VolunteerStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  REJECTED
}

enum CollectionStatus {
  PENDING
  ASSIGNED
  COLLECTED
  CANCELLED
}

// ------------------------------------------------------------------------------
// 1. ADMIN USER & AUTHENTICATION
// ------------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         AdminRole @default(CONTENT_EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ------------------------------------------------------------------------------
// 2. CONTACT & DEPARTMENT INQUIRIES
// ------------------------------------------------------------------------------

model ContactInquiry {
  id         String        @id @default(uuid())
  name       String
  company    String?
  phone      String?
  email      String
  subject    String
  message    String        @db.Text
  status     InquiryStatus @default(NEW)
  adminNotes String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_inquiries")
}

// ------------------------------------------------------------------------------
// 3. VOLUNTEER APPLICATIONS
// ------------------------------------------------------------------------------

model VolunteerApplication {
  id          String          @id @default(uuid())
  fullName    String
  email       String
  phone       String
  city        String
  serviceArea String
  notes       String?         @db.Text
  status      VolunteerStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([city])
  @@index([serviceArea])
  @@index([status])
  @@map("volunteer_applications")
}

// ------------------------------------------------------------------------------
// 4. CAREERS & JOB OPENINGS
// ------------------------------------------------------------------------------

model JobOpening {
  id             String              @id @default(uuid())
  title          String
  department     String
  location       String              @default("Lahore")
  employmentType EmploymentType      @default(FULL_TIME)
  description    String              @db.Text
  requirements   String              @db.Text
  isActive       Boolean             @default(true)
  deadline       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  applications   CareerApplication[]

  @@index([isActive])
  @@map("job_openings")
}

model CareerApplication {
  id               String            @id @default(uuid())
  candidateName    String
  email            String
  phone            String
  positionInterest String?
  jobOpeningId     String?
  jobOpening       JobOpening?       @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  cvFileName       String
  cvFileUrl        String
  cvFileSize       Int
  cvMimeType       String
  status           ApplicationStatus @default(SUBMITTED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([jobOpeningId])
  @@map("career_applications")
}

// ------------------------------------------------------------------------------
// 5. DOORSTEP CASH / CHEQUE COLLECTION REQUESTS
// ------------------------------------------------------------------------------

model DoorstepCollectionRequest {
  id                 String           @id @default(uuid())
  requestCode        String           @unique
  donorName          String
  phone              String
  city               String           @default("Lahore")
  pickupAddress      String           @db.Text
  estimatedAmountPkr Decimal          @db.Decimal(12, 2)
  status             CollectionStatus @default(PENDING)
  assignedOfficer    String?
  scheduledDate      DateTime?
  collectedDate      DateTime?
  notes              String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([requestCode])
  @@index([status])
  @@index([city])
  @@map("doorstep_collections")
}

// ------------------------------------------------------------------------------
// 6. BANK ACCOUNTS DIRECTORY
// ------------------------------------------------------------------------------

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountTitle  String
  accountNumber String
  iban          String   @unique
  swiftCode     String?
  branch        String?
  country       String   @default("Pakistan")
  currency      String   @default("PKR")
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@map("bank_accounts")
}
